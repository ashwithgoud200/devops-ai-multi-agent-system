    {
      "id": 23,
      "type": "timeseries",
      "title": "HTTP Request Rate by Endpoint",
      "description": "5-minute HTTP request rate across bounded FastAPI route templates, methods, and status codes.",
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (endpoint, method, status) (rate(devops_http_requests_total[5m]))",
          "legendFormat": "{{method}} {{endpoint}} ({{status}})",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No Data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
