# Set true only after installing Ollama and pulling all models.
DEVOPS_LLM_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
PROMETHEUS_URL=http://127.0.0.1:9090
PROMETHEUS_TIMEOUT_SECONDS=3
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-dev-change-me
# Optional: DEVOPS_MODEL_CONFIG=config/models.json

# Stage 7: GitHub REST API integration (read-only, disabled by default)
DEVOPS_GITHUB_ENABLED=false
DEVOPS_GITHUB_REPO=
DEVOPS_GITHUB_TOKEN=
DEVOPS_GITHUB_API_URL=https://api.github.com
DEVOPS_GITHUB_TIMEOUT_SECONDS=10

# Stage 7: Offline CI/CD and Security reports ingestion
DEVOPS_CI_EVIDENCE_ENABLED=false
DEVOPS_SECURITY_EVIDENCE_ENABLED=false
DEVOPS_EVIDENCE_IMPORT_DIR=/app/data/ci-security-reports
DEVOPS_EVIDENCE_MAX_AGE_HOURS=168
DEVOPS_EVIDENCE_MAX_FILE_BYTES=5242880
